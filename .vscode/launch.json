{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AML: Deterministic Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/deterministic_aml_demo.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "AML: Qwen Demo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/qwen_aml_demo.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "AML: Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
